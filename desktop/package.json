{
  "name": "continuum-desktop",
  "productName": "Continuum",
  "version": "0.1.0",
  "description": "Continuum（续）桌面端",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "ws": "8.18.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "ai.continuum.desktop",
    "productName": "Continuum",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "lib/**", "renderer/**", "assets/**", "package.json"],
    "win": { "target": "nsis", "icon": "assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
